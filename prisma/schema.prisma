generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  username      String          @unique
  password      String
  avatar        String?
  bio           String?
  ideas         Idea[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  subscriptions Subscriptions[]
  payments      Payment[]
}

model Subscriptions {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  plan   Plan
  status SubscriptionStatus

  startedAt   DateTime
  expiryDate  DateTime?
  lastUpdated DateTime  @updatedAt

  payments Payment[]
}

enum Plan {
  free
  pro
  premium
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

model Payment {
  id                Int      @id @default(autoincrement())

  userId            Int
  subscriptionId    Int

  user              User          @relation(fields: [userId], references: [id])
  subscription      Subscriptions @relation(fields: [subscriptionId], references: [id])

  plan              Plan

  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique

  amount            Int
  currency          String
  status            PaymentStatus

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

model Idea {
  id             Int    @id @default(autoincrement())
  title          String
  pitch          String
  problem        String
  solution       String
  targetAudience String

  businessType String
  geography    String
  stage        String

  revenueModel      String?
  price             String?
  competitors       String?
  assumption        String?
  additionalContext String?

  analysis Json?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
