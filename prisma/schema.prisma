generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  avatar    String?
  bio       String?
  ideas     Idea[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Idea {
  id                Int      @id @default(autoincrement())
  title             String
  pitch             String
  problem           String
  solution          String
  targetAudience    String

  businessType      String
  geography         String
  stage             String

  revenueModel      String?
  price             String?
  competitors       String?
  assumption        String?
  additionalContext String?

  analysis          Json?

  userId            Int
  user              User @relation(fields: [userId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}